# ─────────────────────────────────────────────────────────────
#  Caddy — Reverse proxy + automatic HTTPS (Let's Encrypt)
# ─────────────────────────────────────────────────────────────
#
#  Caddy reads the hostname from the site block below, requests a
#  certificate on first start, and renews it automatically. No certbot,
#  no cron job, no manual renewal.
#
#  DNS for `ucp.losjawa-rp.fun` points at this host through Cloudflare
#  (orange cloud). Caddy trusts Cloudflare's edge ranges so the real client
#  IP survives the proxy hop instead of being replaced by an edge IP.
#
#  To serve a different domain, change the site block hostname and update
#  NEXT_PUBLIC_BASE_URL in the GitHub repository variables.
{
	# Uncomment and set a real address to receive certificate expiry notices.
	# email admin@losjawa-rp.fun

	# Cloudflare edge ranges, from https://www.cloudflare.com/ips/
	# Keep this list current when Cloudflare publishes changes.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# Web portal (Next.js UCP)
ucp.losjawa-rp.fun {
	encode zstd gzip

	reverse_proxy web:3000 {
		# Preserve the original client address for application logging.
		header_up X-Real-IP {client_ip}
	}
}
